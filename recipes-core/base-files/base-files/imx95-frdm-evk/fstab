/dev/root            /                    auto       defaults              1  1
proc                 /proc                proc       defaults              0  0
devpts               /dev/pts             devpts     mode=0620,gid=5       0  0
tmpfs                /run                 tmpfs      mode=0755,nodev,nosuid,strictatime 0  0
tmpfs                /var/volatile        tmpfs      defaults              0  0

# The Foundries U-Boot environment is a file on the boot partition.  Keep the
# partition idle-unmounted, but make fw_printenv/fw_setenv trigger a safe
# systemd automount whenever aktualizr-lite confirms an update or rollback.
/dev/mmcblk0p1       /mnt/boot            vfat       x-systemd.automount,x-systemd.idle-timeout=2,noatime,sync          0  2
