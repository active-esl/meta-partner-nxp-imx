[Unit]
Description=Waydroid graphical session on FRDM-IMX95
Requires=waydroid-container.service waydroid-frdm-dbus.service weston.service
After=waydroid-container.service waydroid-frdm-dbus.service weston.service
BindsTo=weston.service

[Service]
Type=simple
User=weston
Group=weston
SupplementaryGroups=video render wayland
Environment=HOME=/var/rootdirs/home/weston
Environment=XDG_RUNTIME_DIR=/run
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/waydroid-frdm/bus
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/usr/bin/waydroid session start
# The readiness helper inspects LXC and remounts Android's /proc/sys/net.
# Keep the graphical session unprivileged, but run this helper as root.
ExecStartPost=+/usr/libexec/waydroid-frdm-network-ready
# Android starts the LXC guest from this command. Restore the numeric device
# ownership after the readiness helper confirms that setup has completed.
ExecStartPost=+/usr/libexec/waydroid-frdm-device-permissions
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=45

[Install]
WantedBy=graphical.target
