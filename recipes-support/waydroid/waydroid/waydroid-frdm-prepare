#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only

set -eu

base_props=/var/lib/waydroid/waydroid_base.prop
nodes=/var/lib/waydroid/lxc/waydroid/config_nodes

replace_property() {
    key=$1
    value=$2
    tmp=${base_props}.tmp.$$
    awk -F= -v key="${key}" '$1 != key { print }' "${base_props}" > "${tmp}"
    printf '%s=%s\n' "${key}" "${value}" >> "${tmp}"
    chmod 0644 "${tmp}"
    chown 0:0 "${tmp}"
    mv "${tmp}" "${base_props}"
}

remove_property() {
    key=$1
    tmp=${base_props}.tmp.$$
    awk -F= -v key="${key}" '$1 != key { print }' "${base_props}" > "${tmp}"
    chmod 0644 "${tmp}"
    chown 0:0 "${tmp}"
    mv "${tmp}" "${base_props}"
}

append_node_once() {
    entry=$1
    grep -Fqx "${entry}" "${nodes}" || printf '%s\n' "${entry}" >> "${nodes}"
}

test -s "${base_props}"
test -s "${nodes}"
test -c /dev/dma_heap/linux,cma
test -c /dev/dma_heap/linux,cma-uncached
test -c /dev/dma_heap/system
test -c /dev/dmabuf_imx
for node in /dev/video0 /dev/video1 /dev/video2 /dev/video3; do
    test -c "${node}"
done

# The generic host probe cannot see Android's vendor libraries and otherwise
# forces Mesa/GBM. This product uses NXP's Arm allocator; Waydroid imports its
# public mapper layout through linux-dmabuf instead of CPU-locking HWC buffers.
replace_property ro.hardware.egl mali
replace_property ro.hardware.vulkan mali
replace_property ro.hardware.gralloc arm
# SurfaceFlinger and HWUI otherwise exercise Mali extension paths which this
# driver advertises but rejects at runtime.  Disable the shader-cache warm-up
# and partial-damage path before Android starts.
replace_property service.sf.prime_shader_cache 0
replace_property debug.hwui.use_buffer_age false
replace_property debug.hwui.render_dirty_regions false
replace_property debug.hwui.enable_partial_updates false
replace_property debug.hwui.use_partial_updates false
# The FRDM appliance owns the HDMI output. Ask the Wayland HWC to use the
# xdg-shell fullscreen state instead of the desktop-shell maximized work area.
replace_property persist.waydroid.fullscreen true
remove_property gralloc.gbm.device
remove_property debug.stagefright.ccodec

# NXP's Android allocator asks for these canonical heap names.  The FRDM host
# exposes the same heaps as linux,cma-uncached and system.  Map only those two
# nodes into the container. NXP's reference i.MX95 uevent rules make these
# heaps available to application-side Codec2 allocators.
chown 1000:1003 /dev/dma_heap/linux,cma /dev/dma_heap/linux,cma-uncached /dev/dma_heap/system
chmod 0666 /dev/dma_heap/linux,cma /dev/dma_heap/linux,cma-uncached /dev/dma_heap/system
append_node_once 'lxc.mount.entry = /dev/dma_heap/linux,cma dev/dma_heap/reserved none bind,create=file 0 0'
append_node_once 'lxc.mount.entry = /dev/dma_heap/linux,cma-uncached dev/dma_heap/reserved-uncached none bind,create=file 0 0'
append_node_once 'lxc.mount.entry = /dev/dma_heap/system dev/dma_heap/system-uncached none bind,create=file 0 0'

# The NXP allocator and Codec2 stack use this helper to identify DMA-BUF
# exporters and obtain physical addresses. Its major is allocated at runtime.
dmabuf_major=$(printf '%d' "0x$(stat -c %t /dev/dmabuf_imx)")
chown 1000:1000 /dev/dmabuf_imx
chmod 0666 /dev/dmabuf_imx
append_node_once "lxc.cgroup2.devices.allow = c ${dmabuf_major}:* rwm"
append_node_once 'lxc.mount.entry = /dev/dmabuf_imx dev/dmabuf_imx none bind,create=file 0 0'

# Apply the intended modes before startup as well. Waydroid rewrites the host
# device modes while constructing the container; ExecStartPost reapplies them
# after LXC reaches RUNNING.
chown 0:1006 /dev/video0 /dev/video1 /dev/video2 /dev/video3
chmod 0660 /dev/video0 /dev/video1 /dev/video2 /dev/video3
