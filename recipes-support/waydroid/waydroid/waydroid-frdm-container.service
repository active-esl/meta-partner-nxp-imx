[Unit]
Description=Waydroid container on FRDM-IMX95
Requires=waydroid-image-provision.service
Wants=docker.service
After=waydroid-image-provision.service dbus.service docker.service
PartOf=docker.service
ConditionPathExists=/var/lib/waydroid/waydroid.cfg

[Service]
Type=simple
ExecStartPre=/usr/libexec/waydroid-frdm-prepare
ExecStart=/usr/bin/waydroid container start
ExecStartPost=/usr/libexec/waydroid-frdm-network-ready
Restart=on-failure
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
