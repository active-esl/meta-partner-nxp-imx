[Unit]
Description=Present the Waydroid full-screen UI on FRDM-IMX95
Requires=waydroid-frdm-session.service
After=waydroid-frdm-session.service
PartOf=waydroid-frdm-session.service

[Service]
Type=oneshot
User=fio
Group=fio
SupplementaryGroups=video render wayland
Environment=HOME=/home/fio
Environment=XDG_RUNTIME_DIR=/run
Environment=WAYLAND_DISPLAY=wayland-0
ExecStartPre=/usr/libexec/waydroid-product-wait session
# The Waydroid session must remain UID 63 so Android's host HWC can connect to
# Weston's socket. Android's privileged host Binder identity is UID 1000, so
# present the UI through the direct Binder helper under the fio account.
ExecStartPre=+/usr/bin/waydroid container unfreeze
ExecStart=/usr/libexec/waydroid-frdm-show-ui
RemainAfterExit=yes
TimeoutStartSec=180

[Install]
WantedBy=graphical.target
