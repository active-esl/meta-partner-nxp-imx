#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only

set -eu

container=waydroid
lxc_path=/var/lib/waydroid/lxc
deadline=$(($(date +%s) + 150))

while [ "$(date +%s)" -lt "${deadline}" ]; do
    state=$(lxc-info -P "${lxc_path}" -n "${container}" -sH 2>/dev/null || true)
    [ "${state}" = RUNNING ] && break
    sleep 1
done

if [ "${state:-}" != RUNNING ]; then
    echo "Waydroid LXC did not reach RUNNING state" >&2
    exit 1
fi

# Android init reapplies the read-only proc policy after LXC reaches RUNNING.
# Wait until netd is up so our narrower remount is the final mount operation.
while [ "$(date +%s)" -lt "${deadline}" ]; do
    netd=$(timeout 3 /usr/bin/waydroid --details-to-stdout shell -C -L -- \
        getprop init.svc.netd 2>/dev/null || true)
    [ "${netd}" = running ] && break
    sleep 1
done

if [ "${netd:-}" != running ]; then
    echo "Android netd did not reach running state" >&2
    exit 1
fi

# LXC installs the nested proc/sys/net bind after the read-only proc/sys bind.
# Linux retains the parent bind's read-only flag on this kernel, so Android's
# IpClient cannot set per-interface networking sysctls until this exact mount
# is remounted. Keep the rest of proc/sys read-only.
timeout 10 /usr/bin/waydroid --details-to-stdout shell -C -L -- \
    mount -o remount,rw /proc/sys/net
timeout 10 /usr/bin/waydroid --details-to-stdout shell -C -L -- \
    grep -q ' /proc/sys/net rw,' /proc/self/mountinfo
