uuu_version 1.5.201

# Keep all ROM/SPL protocol stages. UUU selects the commands which match the
# USB identity exposed by the SoC; this is the NXP i.MX95 flash_all flow.
# UUU 1.5.201 is required: it understands AHAB container v2 and the V2X header,
# so SDPS sends only the ROM/SPL portion and SDPV resumes at the app container.
SDP: boot -f imx-boot-mfgtool
SDPS: boot -f imx-boot-mfgtool

SDPU: delay 1000
SDPU: write -f imx-boot-mfgtool -offset 0x57c00
SDPU: jump

SDPV: delay 1000
SDPV: write -f imx-boot-mfgtool -skipspl
SDPV: jump

FB: delay 5000
# FRDM onboard eMMC = USDHC1 = U-Boot mmc dev 0.
FB: ucmd setenv fastboot_dev mmc
FB: ucmd setenv emmc_dev 0
FB: ucmd setenv mmcdev 0
FB: ucmd setenv loadaddr 0x92800000
FB: ucmd mmc dev ${mmcdev} 0
# Fail before the first write unless NXP FSL fastboot exposes its native whole
# eMMC user-area target. This guards the Foundries WIC programming contract.
FB: getvar partition-size:all
FB: getvar partition-type:all
# Validate both Foundries boot sets before the first persistent write.  The
# i.MX95 primary container deliberately overlaps its separately signed FIT;
# the secondary set mirrors that layout in eMMC boot1.
FB: getvar partition-size:bootloader
FB: getvar partition-type:bootloader
FB: getvar partition-size:bootloader2
FB: getvar partition-type:bootloader2
FB: getvar partition-size:bootloader_s
FB: getvar partition-type:bootloader_s
FB: getvar partition-size:bootloader2_s
FB: getvar partition-type:bootloader2_s
# Use the Foundries mfgtool WIC contract. UUU decompresses the image on the
# host, converts it to Android sparse chunks, and flashes the U-Boot `all` raw
# target so GPT, partitions and required gaps retain the generated WIC layout.
FB[-t 1800000]: flash -raw2sparse all ../@@MFGTOOL_FLASH_IMAGE@@-@@MACHINE@@@@IMAGE_NAME_SUFFIX@@.wic.gz/*
# Install the production boot chain after the Foundries partition image.
FB: flash bootloader ../imx-boot-@@MACHINE@@
FB: flash bootloader2 ../u-boot-@@MACHINE@@.itb
FB: flash bootloader_s ../imx-boot-@@MACHINE@@
FB: flash bootloader2_s ../u-boot-@@MACHINE@@.itb
FB: ucmd if env exists emmc_ack; then ; else setenv emmc_ack 0; fi;
FB: ucmd mmc partconf 0 ${emmc_ack} 1 0
FB: done
