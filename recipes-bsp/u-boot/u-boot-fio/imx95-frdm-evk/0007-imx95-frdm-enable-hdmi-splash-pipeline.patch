From 2c1ad41a6ea372ce1003042ac2283ea5e41a5300 Mon Sep 17 00:00:00 2001
From: Active Edge Solutions <engineering@active-esl.com>
Date: Fri, 11 Sep 2026 12:00:00 +0100
Subject: [PATCH] imx95: frdm: enable LVDS to HDMI video pipeline

The FRDM-IMX95 routes DPU output 1 through the display pixel link, pixel
interleaver, LDB channel 1 and the on-board IT6263 bridge to J17.  Describe
that path in U-Boot and enable the two drivers omitted by the NXP defconfig.

The U-Boot IT6263 driver did not handle the reset-gpios binding used by the
board.  Pulse that optional line during probe so boot display does not depend
on the bridge state left by an earlier boot stage.

Use the 1280x720 mode supported by the current U-Boot IT6263 driver.  Linux
and the product compositor deliberately select the same mode for a continuous
handoff.

Signed-off-by: Active Edge Solutions <engineering@active-esl.com>
---
 arch/arm/dts/imx95-15x15-frdm.dts  | 76 +++++++++++++++++++++++++++++
 configs/imx95_15x15_frdm_defconfig |  2 +
 drivers/video/it6263_bridge.c      | 15 ++++++
 3 files changed, 93 insertions(+)

diff --git a/arch/arm/dts/imx95-15x15-frdm.dts b/arch/arm/dts/imx95-15x15-frdm.dts
index 18039bee9..9167d5b2d 100644
--- a/arch/arm/dts/imx95-15x15-frdm.dts
+++ b/arch/arm/dts/imx95-15x15-frdm.dts
@@ -92,6 +92,70 @@
 	status = "okay";
 };
 
+&display_pixel_link {
+	status = "okay";
+};
+
+&dpu {
+	clocks = <&scmi_clk IMX95_CLK_DISP1PIX>,
+		 <&scmi_clk IMX95_CLK_DISPAPB>,
+		 <&scmi_clk IMX95_CLK_DISPAXI>,
+		 <&scmi_clk IMX95_CLK_DISPOCRAM>,
+		 <&scmi_clk IMX95_CLK_LDBPLL>,
+		 <&scmi_clk IMX95_CLK_LDBPLL_VCO>;
+	status = "okay";
+};
+
+&ldb {
+	assigned-clocks = <&scmi_clk IMX95_CLK_LDBPLL_VCO>,
+			  <&scmi_clk IMX95_CLK_LDBPLL>;
+	assigned-clock-rates = <4158000000>, <1039500000>;
+	assigned-clock-parents = <0>, <&scmi_clk IMX95_CLK_LDBPLL_VCO>;
+	status = "okay";
+
+	channel@1 {
+		fsl,data-mapping = "jeida";
+		fsl,data-width = <24>;
+		status = "okay";
+
+		display-timings {
+			native-mode = <&timing0>;
+
+			timing0: timing0 {
+				clock-frequency = <74250000>;
+				hactive = <1280>;
+				vactive = <720>;
+				hfront-porch = <220>;
+				hback-porch = <110>;
+				hsync-len = <40>;
+				vback-porch = <5>;
+				vfront-porch = <20>;
+				vsync-len = <5>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+
+			lvds1_out: endpoint {
+				remote-endpoint = <&it6263_in>;
+			};
+		};
+	};
+};
+
+&ldb1_phy {
+	status = "okay";
+};
+
+&pixel_interleaver {
+	status = "okay";
+
+	channel@1 {
+		status = "okay";
+	};
+};
+
 &enetc_port0 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_enetc0>;
@@ -156,6 +220,18 @@
 		interrupt-parent = <&gpio5>;
 		interrupts = <14 IRQ_TYPE_LEVEL_LOW>;
 	};
+
+	bridge@4c {
+		compatible = "ite,it6263";
+		reg = <0x4c>;
+		reset-gpios = <&pcal6524 23 GPIO_ACTIVE_LOW>;
+
+		port {
+			it6263_in: endpoint {
+				remote-endpoint = <&lvds1_out>;
+			};
+		};
+	};
 };
 
 &lpi2c3 {
diff --git a/configs/imx95_15x15_frdm_defconfig b/configs/imx95_15x15_frdm_defconfig
index ce8cbde68..618006a40 100644
--- a/configs/imx95_15x15_frdm_defconfig
+++ b/configs/imx95_15x15_frdm_defconfig
@@ -215,6 +215,7 @@ CONFIG_VIDEO_IMX95_DPU=y
 CONFIG_VIDEO_IMX95_DW_DSI=y
 CONFIG_VIDEO_IMX95_PIXEL_LINK=y
 CONFIG_VIDEO_IMX95_PIXEL_INTERLEAVER=y
+CONFIG_VIDEO_IMX95_LVDS=y
 CONFIG_VIDEO=y
 CONFIG_BMP_16BPP=y
 CONFIG_BMP_24BPP=y
@@ -222,6 +223,7 @@ CONFIG_BMP_32BPP=y
 CONFIG_VIDEO_LOGO=y
 CONFIG_VIDEO_LCD_RAYDIUM_RM692C9=y
 CONFIG_VIDEO_ADV7535=y
+CONFIG_VIDEO_IT6263_BRIDGE=y
 CONFIG_SYS_WHITE_ON_BLACK=y
 CONFIG_SPLASH_SCREEN=y
 CONFIG_SPLASH_SCREEN_ALIGN=y
diff --git a/drivers/video/it6263_bridge.c b/drivers/video/it6263_bridge.c
index 67a48923d..71d28f2f7 100644
--- a/drivers/video/it6263_bridge.c
+++ b/drivers/video/it6263_bridge.c
@@ -6,6 +6,7 @@
  */
 
 #include <dm.h>
+#include <dm/device_compat.h>
 #include <video.h>
 #include <video_bridge.h>
 #include <asm/gpio.h>
@@ -13,6 +14,7 @@
 
 struct it6263_priv {
 	unsigned int addr;
+	struct gpio_desc reset_gpio;
 };
 
 static int it6263_i2c_reg_write(struct udevice *dev, uint addr, uint mask, uint data)
@@ -183,6 +184,7 @@ static int it6263_set_backlight(struct udevice *dev, int percent)
 static int it6263_probe(struct udevice *dev)
 {
 	struct it6263_priv *priv = dev_get_priv(dev);
+	int ret;
 
 	debug("%s\n", __func__);
 
@@ -190,6 +192,18 @@ static int it6263_probe(struct udevice *dev)
 	if (priv->addr  == 0)
 		return -ENODEV;
 
+	ret = gpio_request_by_name(dev, "reset-gpios", 0, &priv->reset_gpio,
+				   GPIOD_IS_OUT);
+	if (!ret) {
+		dm_gpio_set_value(&priv->reset_gpio, 1);
+		mdelay(1);
+		dm_gpio_set_value(&priv->reset_gpio, 0);
+		mdelay(10);
+	} else if (ret != -ENOENT) {
+		dev_err(dev, "failed to request reset GPIO: %d\n", ret);
+		return ret;
+	}
+
 	return 0;
 }
 
