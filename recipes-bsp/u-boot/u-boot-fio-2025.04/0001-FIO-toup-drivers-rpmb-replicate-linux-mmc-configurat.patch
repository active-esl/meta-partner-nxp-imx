From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jorge Ramirez-Ortiz <jorge@foundries.io>
Date: Thu, 14 Nov 2019 17:48:03 +0100
Subject: [PATCH 01/17] [FIO toup] drivers: rpmb: replicate linux mmc
 configuration

Upstream-Status: Pending
Signed-off-by: Jorge Ramirez-Ortiz <jorge@foundries.io>
Signed-off-by: Oleksandr Suvorov <oleksandr.suvorov@foundries.io>
(cherry picked from commit 6b20f325ed03f7c4c36acf033682b8690bb9c645)
---
 drivers/mmc/rpmb.c | 6 +++---
 include/mmc.h      | 1 +
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/drivers/mmc/rpmb.c b/drivers/mmc/rpmb.c
index 05b9d029a20..0608c2e2695 100644
--- a/drivers/mmc/rpmb.c
+++ b/drivers/mmc/rpmb.c
@@ -86,7 +86,7 @@ int mmc_rpmb_request(struct mmc *mmc, const struct s_rpmb *s,
 
 	cmd.cmdidx = MMC_CMD_WRITE_MULTIPLE_BLOCK;
 	cmd.cmdarg = 0;
-	cmd.resp_type = MMC_RSP_R1;
+	cmd.resp_type = MMC_RSP_R1b;
 
 	if (host->quirks & SDHCI_QUIRK_BROKEN_R1B)
 		cmd.resp_type = MMC_RSP_R1;
@@ -322,7 +322,7 @@ static int send_write_mult_block(struct mmc *mmc, const struct s_rpmb *frm,
 {
 	struct mmc_cmd cmd = {
 		.cmdidx = MMC_CMD_WRITE_MULTIPLE_BLOCK,
-		.resp_type = MMC_RSP_R1,
+		.resp_type = MMC_RSP_R1 | MMC_CMD_ADTC,
 	};
 	struct mmc_data data = {
 		.src = (const void *)frm,
@@ -339,7 +339,7 @@ static int send_read_mult_block(struct mmc *mmc, struct s_rpmb *frm,
 {
 	struct mmc_cmd cmd = {
 		.cmdidx = MMC_CMD_READ_MULTIPLE_BLOCK,
-		.resp_type = MMC_RSP_R1,
+		.resp_type = MMC_RSP_R1 | MMC_CMD_ADTC,
 	};
 	struct mmc_data data = {
 		.dest = (void *)frm,
diff --git a/include/mmc.h b/include/mmc.h
index b68616afdbb..bba75eacdb9 100644
--- a/include/mmc.h
+++ b/include/mmc.h
@@ -318,6 +318,7 @@ static inline bool mmc_is_tuning_cmd(uint cmdidx)
 #define MMC_RSP_CRC	(1 << 2)		/* expect valid crc */
 #define MMC_RSP_BUSY	(1 << 3)		/* card may send busy */
 #define MMC_RSP_OPCODE	(1 << 4)		/* response contains opcode */
+#define MMC_CMD_ADTC	(1 << 5)	/* Addressed data transfer command */
 
 #define MMC_RSP_NONE	(0)
 #define MMC_RSP_R1	(MMC_RSP_PRESENT|MMC_RSP_CRC|MMC_RSP_OPCODE)
