From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dynamic Devices BSP Team <support@dynamicdevices.co.uk>
Date: Wed, 9 Sep 2026 16:51:16 +0100
Subject: [PATCH 17/17] imx9: add Foundries boot-state helpers for SCMI
 firmware

---
 arch/arm/include/asm/arch-imx9/sys_proto.h |  4 +++
 arch/arm/mach-imx/imx9/scmi/soc.c          | 31 ++++++++++++++++++++++
 2 files changed, 35 insertions(+)

diff --git a/arch/arm/include/asm/arch-imx9/sys_proto.h b/arch/arm/include/asm/arch-imx9/sys_proto.h
index 9d2e384c05f..84b2d08d36d 100644
--- a/arch/arm/include/asm/arch-imx9/sys_proto.h
+++ b/arch/arm/include/asm/arch-imx9/sys_proto.h
@@ -27,6 +27,10 @@ int power_on_m7(char *name);
 
 int disable_smmuv3(void);
 
+int boot_mode_getprisec(void);
+int boot_mode_is_closed(void);
+void boot_mode_enable_secondary(bool enable);
+
 #define is_voltage_mode(mode) (soc_target_voltage_mode() == (mode))
 
 #endif
diff --git a/arch/arm/mach-imx/imx9/scmi/soc.c b/arch/arm/mach-imx/imx9/scmi/soc.c
index 1d75b34fb17..51e711bd34c 100644
--- a/arch/arm/mach-imx/imx9/scmi/soc.c
+++ b/arch/arm/mach-imx/imx9/scmi/soc.c
@@ -65,6 +65,37 @@ uint32_t scmi_get_rom_data(rom_passover_t *rom_data)
 	return 0;
 }
 
+void boot_mode_enable_secondary(bool enable)
+{
+	/*
+	 * i.MX95 SCMI firmware does not expose the persistent SRC selector used
+	 * by i.MX8M.  Foundries therefore uses its alternative boot-firmware
+	 * update flow: preserve the known-good image in eMMC boot1, update boot0,
+	 * and let ROM recovery select boot1 if validation of boot0 fails.
+	 */
+	printf("Software selection of the %s boot set is unsupported on i.MX95\n",
+	       enable ? "secondary" : "primary");
+}
+
+int boot_mode_is_closed(void)
+{
+	u32 lc = readl(FSB_BASE_ADDR + 0x41c) & 0x3ff;
+
+	return lc == 0x20;
+}
+
+int boot_mode_getprisec(void)
+{
+	rom_passover_t rom_data = {0};
+
+	if (scmi_get_rom_data(&rom_data)) {
+		puts("SCMI: failure at rom_boot_info for BT_STAGE\n");
+		return 0;
+	}
+
+	return rom_data.boot_stage == BT_STAGE_SECONDARY;
+}
+
 int scmi_set_bbnsm_gpr(u32 gpr_id, u32 val)
 {
 	struct scmi_bbm_gpr_in in;
